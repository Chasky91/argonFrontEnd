---
import { API_URL } from "astro:env/server"


const  titulo = " Pagina Principal Lab III"

const getUsers = async() => {
	console.log(API_URL, "URL delServidor")
	//GET http://localhost:3000/user/users?page=1&limit=4
	const  users = await fetch(`${API_URL}/user/users`)
	return users.json()
}

const  page = Number(Astro.url.searchParams.get("page")) ?? "No hay  page" //rescatamos  el  valor  de  la  url  de  page
const pageParam = Number.isInteger(page) && page > 0 ? page : 1

const limite = 5

console.log(pageParam)
const  usersResult = await getUsers()
console.log(usersResult.totalItems, "Total Items")
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{titulo}</title>
	</head>
	<body>
		<h1>Usuarios</h1>
		<table>
			<tr>
				<th>ID</th>
				<th>Nombre</th>
				<th>Email</th>
				<th>Creado</th>
			</tr>
			{usersResult.result.map((u) => (
				<tr>
					<td>{u.id}</td>
					<td>{u.name}</td>
					<td>{u.email}</td>
					<td>{u.created_at}</td>
				</tr>
			) )}
			

		</table>
		<p>Cantidad  de paginas {usersResult.totalPages}</p>
		<p>Pagina {usersResult.currentPage}</p>
		<p>Número de usuarios {usersResult.totalItems}</p>
		<script type="module" >
			console.log("Hola estoy en el html")
		</script>
	</body>
</html>
